+/*
+ * These helpers require enabled interface clocks and a matching INTF flush.
+ * The caller supplies timings after bonded-link and DSC width conversion.
+ * This validates register arithmetic, not the panel's supported VRR range.
+ */
+static int dpu_hw_intf_setup_avr(struct dpu_hw_intf *intf,
+				 const struct dpu_hw_intf_timing_params *p, u32 max_vtotal)
+{
+	u64 htotal = (u64)p->width + p->h_front_porch +
+		     p->h_back_porch + p->hsync_pulse_width;
+	u64 vtotal = (u64)p->height + p->v_front_porch +
+		     p->v_back_porch + p->vsync_pulse_width;
+	u32 max_period;
+
+	if (!htotal || htotal > U32_MAX || !vtotal || max_vtotal < vtotal)
+		return -EINVAL;
+	if (check_mul_overflow((u32)htotal, max_vtotal, &max_period))
+		return -EOVERFLOW;
+
+	DPU_REG_WRITE(&intf->hw, INTF_AVR_VTOTAL, max_period);
+	return 0;
+}
