+/* Caller holds the CRTC commit serialization and both active link references. */
+static int dsi_host_check_avr(struct msm_dsi_host *msm_host)
+{
+	if (msm_host->cfg_hnd->major != MSM_DSI_VER_MAJOR_6G ||
+	    msm_host->cfg_hnd->minor != MSM_DSI_6G_VER_MINOR_V2_9_0 ||
+	    !(msm_host->mode_flags & MIPI_DSI_MODE_VIDEO))
+		return -EOPNOTSUPP;
+
+	if (!msm_host->power_on || !msm_host->enabled)
+		return -EPIPE;
+
+	return 0;
+}
+
+static void dsi_host_write_avr(struct msm_dsi_host *msm_host, bool enable)
+{
+	u32 data = dsi_read(msm_host, REG_DSI_VID_CFG0);
+
+	if (enable)
+		data |= DSI_VID_CFG0_AVR_SUPPORT_ENABLE;
+	else
+		data &= ~DSI_VID_CFG0_AVR_SUPPORT_ENABLE;
+	dsi_write(msm_host, REG_DSI_VID_CFG0, data);
+	msm_host->avr_enabled = enable;
+}
