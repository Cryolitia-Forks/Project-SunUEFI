From ada687cae527c0c4dcaa159fd071dd9c9459b041 Mon Sep 17 00:00:00 2001
From: Cryolitia PukNgae <cryolitia@gmail.com>
Date: Fri, 6 Nov 2026 06:31:07 +0800
Subject: [PATCH] drm/msm: support bonded DSI AVR atomic updates

Configure DPU AVR and both DSI receivers through atomic commits on the
bonded video topology. Trigger both interfaces after normal plane flush,
exit AVR before bridge shutdown, and size waits from the maximum frame
period. Use real IRQ timestamps while front-porch duration varies.

Require an explicit connector capability and monitor range; unsupported
requests keep fixed timing. This change publishes neither for P81. Panel
continuous timing limits and recovery after an AVR exit timeout remain
outside the implemented normal path.
---
 drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c      |  44 +++-
 drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.h      |   1 +
 drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c   | 241 ++++++++++++++++++
 drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.h   |  12 +
 .../drm/msm/disp/dpu1/dpu_encoder_phys_vid.c  |  24 +-
 drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.c   |  46 +++-
 drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.h   |   7 +
 drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c       |  22 ++
 drivers/gpu/drm/msm/dsi/dsi.h                 |   2 +
 drivers/gpu/drm/msm/dsi/dsi_host.c            |  63 +++++
 drivers/gpu/drm/msm/dsi/dsi_manager.c         |  16 ++
 drivers/gpu/drm/msm/msm_drv.h                 |   6 +
 drivers/gpu/drm/msm/registers/display/dsi.xml |   1 +
 13 files changed, 481 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
index 77bfbd02d..3d93c9db8 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
@@ -269,6 +269,22 @@ static int dpu_crtc_get_crc(struct drm_crtc *crtc)
 	return -EINVAL;
 }
 
+static bool dpu_crtc_get_vblank_timestamp(struct drm_crtc *crtc,
+					 int *max_error, ktime_t *vblank_time,
+					 bool in_vblank_irq)
+{
+	struct drm_encoder *encoder = get_encoder_from_crtc(crtc);
+
+	/*
+	 * A waiting AVR front porch has no predictable end. Use the real IRQ
+	 * timestamp fallback instead of extrapolating from nominal vtotal.
+	 */
+	if (encoder && dpu_encoder_vrr_active(encoder))
+		return false;
+	return drm_crtc_vblank_helper_get_vblank_timestamp(crtc, max_error,
+							vblank_time, in_vblank_irq);
+}
+
 static bool dpu_crtc_get_scanout_position(struct drm_crtc *crtc,
 					   bool in_vblank_irq,
 					   int *vpos, int *hpos,
@@ -1264,6 +1280,7 @@ static void dpu_crtc_atomic_print_state(struct drm_printer *p,
 	const struct dpu_crtc_state *cstate = to_dpu_crtc_state(state);
 	int i;
 
+	drm_printf(p, "\tavr_max_vtotal=%u\n", cstate->avr_max_vtotal);
 	for (i = 0; i < cstate->num_mixers; i++) {
 		drm_printf(p, "\tlm[%d]=%d\n", i, cstate->mixers[i].hw_lm->idx - LM_0);
 		drm_printf(p, "\tctl[%d]=%d\n", i, cstate->mixers[i].lm_ctl->idx - CTL_0);
@@ -1684,9 +1701,30 @@ static int dpu_crtc_atomic_check(struct drm_crtc *crtc,
 
 	int rc = 0;
 
+	struct drm_encoder *encoder;
 	bool needs_dirtyfb = dpu_crtc_needs_dirtyfb(crtc_state);
 	struct dpu_kms *kms = _dpu_crtc_get_kms(crtc);
 
+	cstate->avr_max_vtotal = 0;
+	if (crtc_state->active && crtc_state->vrr_enabled) {
+		struct drm_crtc_state *old = drm_atomic_get_old_crtc_state(state, crtc);
+
+		if (old->active && old->vrr_enabled && !crtc_state->mode_changed &&
+		    !crtc_state->connectors_changed && !crtc_state->active_changed &&
+		    old->encoder_mask == crtc_state->encoder_mask &&
+		    old->self_refresh_active == crtc_state->self_refresh_active) {
+			cstate->avr_max_vtotal = to_dpu_crtc_state(old)->avr_max_vtotal;
+		} else {
+			/* Range and preferred-mode metadata need the connection mutex. */
+			rc = drm_atomic_add_affected_connectors(state, crtc);
+			if (rc)
+				return rc;
+			drm_for_each_encoder_mask(encoder, crtc->dev, crtc_state->encoder_mask)
+				cstate->avr_max_vtotal =
+					dpu_encoder_check_vrr(encoder, state, crtc_state);
+		}
+	}
+
 	/* A hardware failure latches the engine unusable. Do not accept a
 	 * later gamma update as though its transport were still initialized.
 	 */
@@ -1760,6 +1798,10 @@ static int dpu_crtc_atomic_check(struct drm_crtc *crtc,
 
 	cstate->vfp_update = dpu_crtc_can_update_vfp(
 		drm_atomic_get_old_crtc_state(state, crtc), crtc_state);
+	if (cstate->vfp_update &&
+	    (cstate->avr_max_vtotal ||
+	     to_dpu_crtc_state(drm_atomic_get_old_crtc_state(state, crtc))->avr_max_vtotal))
+		cstate->vfp_update = false;
 	if (cstate->vfp_update)
 		crtc_state->mode_changed = false;
 
@@ -2029,7 +2071,7 @@ static const struct drm_crtc_funcs dpu_crtc_funcs = {
 	.set_crc_source = dpu_crtc_set_crc_source,
 	.enable_vblank  = msm_crtc_enable_vblank,
 	.disable_vblank = msm_crtc_disable_vblank,
-	.get_vblank_timestamp = drm_crtc_vblank_helper_get_vblank_timestamp,
+	.get_vblank_timestamp = dpu_crtc_get_vblank_timestamp,
 	.get_vblank_counter = dpu_crtc_get_vblank_counter,
 };
 
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.h b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.h
index 084ea8ecf..a83f3a2fc 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.h
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.h
@@ -211,6 +211,7 @@ struct dpu_crtc_state {
 	bool bw_control;
 	bool bw_split_vote;
 	bool vfp_update;
+	u32 avr_max_vtotal;
 	struct drm_rect lm_bounds[CRTC_DUAL_MIXERS];
 
 	uint64_t input_fence_timeout_ns;
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
index 416f15afc..1e980c48a 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
@@ -16,6 +16,8 @@
 #include <drm/display/drm_dsc_helper.h>
 #include <drm/drm_atomic.h>
 #include <drm/drm_crtc.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_vblank.h>
 #include <drm/drm_file.h>
 #include <drm/drm_probe_helper.h>
 #include <drm/drm_framebuffer.h>
@@ -202,6 +204,8 @@ struct dpu_encoder_virt {
 	atomic_t frame_done_timeout_ms;
 	atomic_t frame_done_timeout_cnt;
 	struct timer_list frame_done_timer;
+	u32 avr_max_vtotal;
+	bool avr_failed;
 
 	struct msm_display_info disp_info;
 
@@ -717,6 +721,213 @@ void dpu_encoder_update_topology(struct drm_encoder *drm_enc,
 	}
 }
 
+static int dpu_encoder_resource_control(struct drm_encoder *drm_enc,
+				       u32 sw_event);
+
+static bool dpu_encoder_same_vrr_family(const struct drm_display_mode *a,
+					const struct drm_display_mode *b)
+{
+	return a->clock == b->clock && a->flags == b->flags &&
+		a->hdisplay == b->hdisplay && a->htotal == b->htotal &&
+		a->hsync_start == b->hsync_start && a->hsync_end == b->hsync_end &&
+		a->hskew == b->hskew && a->vdisplay == b->vdisplay &&
+		a->vscan == b->vscan &&
+		a->vtotal - a->vsync_start == b->vtotal - b->vsync_start &&
+		a->vtotal - a->vsync_end == b->vtotal - b->vsync_end;
+}
+
+u32 dpu_encoder_check_vrr(struct drm_encoder *encoder,
+			 struct drm_atomic_commit *state,
+			 struct drm_crtc_state *crtc_state)
+{
+	struct dpu_encoder_virt *enc = to_dpu_encoder_virt(encoder);
+	const struct drm_display_mode *mode = &crtc_state->adjusted_mode;
+	struct drm_connector *connector;
+	struct drm_display_mode *native;
+	u64 capable, max_vtotal;
+	u32 min_hz, max_hz;
+	bool native_found = false;
+	unsigned int i;
+
+	if (!crtc_state->active || !crtc_state->vrr_enabled ||
+	    crtc_state->self_refresh_active ||
+	    hweight32(crtc_state->encoder_mask) != 1 ||
+	    enc->disp_info.num_of_h_tiles != 2 ||
+	    !of_machine_is_compatible("xiaomi,piano") ||
+	    enc->disp_info.intf_type != INTF_DSI || enc->disp_info.is_cmd_mode)
+		return 0;
+
+	connector = drm_atomic_get_new_connector_for_encoder(state, encoder);
+	if (!connector || !connector->vrr_capable_property ||
+	    drm_object_property_get_value(&connector->base,
+			connector->vrr_capable_property, &capable) || !capable)
+		return 0;
+
+	/* Only a validated receiver range may authorize AVR. P81 has none yet. */
+	min_hz = connector->display_info.monitor_range.min_vfreq;
+	max_hz = connector->display_info.monitor_range.max_vfreq;
+	if (!min_hz || max_hz < min_hz ||
+	    drm_mode_vrefresh(mode) < min_hz || drm_mode_vrefresh(mode) > max_hz)
+		return 0;
+
+	list_for_each_entry(native, &connector->modes, head) {
+		if (!(native->type & DRM_MODE_TYPE_PREFERRED))
+			continue;
+		if (!dpu_encoder_same_vrr_family(mode, native))
+			return 0;
+		native_found = true;
+		break;
+	}
+	if (!native_found)
+		return 0;
+
+	for (i = 0; i < enc->num_phys_encs; i++) {
+		struct dpu_hw_intf *intf = enc->phys_encs[i]->hw_intf;
+
+		if (!intf || !intf->ops.setup_avr || !intf->ops.enable_avr ||
+		    !intf->ops.trigger_avr ||
+		    mode->vtotal - mode->vsync_start < intf->cap->prog_fetch_lines_worst_case)
+			return 0;
+	}
+
+	max_vtotal = div64_u64((u64)mode->clock * 1000,
+				(u64)mode->htotal * min_hz);
+	if (max_vtotal <= mode->vtotal || max_vtotal > U32_MAX)
+		return 0;
+	return max_vtotal;
+}
+
+bool dpu_encoder_vrr_active(struct drm_encoder *encoder)
+{
+	return READ_ONCE(to_dpu_encoder_virt(encoder)->avr_max_vtotal) != 0;
+}
+
+u32 dpu_encoder_vrr_timeout_ms(struct drm_encoder *encoder, u32 frames)
+{
+	struct dpu_encoder_virt *enc = to_dpu_encoder_virt(encoder);
+	u32 max_vtotal = READ_ONCE(enc->avr_max_vtotal);
+	const struct drm_display_mode *mode;
+
+	if (!max_vtotal || !enc->cur_master)
+		return 0;
+	mode = &enc->cur_master->cached_mode;
+	return DIV_ROUND_UP_ULL((u64)frames * max_vtotal * mode->htotal,
+			       mode->clock);
+}
+
+static int dpu_encoder_configure_vrr(struct drm_encoder *encoder, u32 max_vtotal)
+{
+	struct dpu_encoder_virt *enc = to_dpu_encoder_virt(encoder);
+	struct msm_drm_private *priv = encoder->dev->dev_private;
+	u32 index = enc->disp_info.h_tile_instance[0];
+	unsigned long flags;
+	unsigned int i;
+	int ret;
+
+	if (!max_vtotal || READ_ONCE(enc->avr_failed) || enc->avr_max_vtotal)
+		return 0;
+
+	/* The prototype implements the known bonded, shared-CTL topology only. */
+	for (i = 0; i < enc->num_phys_encs; i++) {
+		struct dpu_encoder_phys *phys = enc->phys_encs[i];
+
+		if (phys->hw_ctl != enc->cur_master->hw_ctl)
+			return -EOPNOTSUPP;
+	}
+
+	ret = msm_dsi_set_avr(priv->kms->dsi[index], true);
+	if (ret)
+		return ret;
+	for (i = 0; i < enc->num_phys_encs; i++) {
+		ret = dpu_encoder_phys_vid_setup_avr(enc->phys_encs[i], max_vtotal);
+		if (ret) {
+			msm_dsi_set_avr(priv->kms->dsi[index], false);
+			return ret;
+		}
+	}
+
+	spin_lock_irqsave(&enc->enc_spinlock, flags);
+	WRITE_ONCE(enc->avr_max_vtotal, max_vtotal);
+	for (i = 0; i < enc->num_phys_encs; i++) {
+		struct dpu_encoder_phys *phys = enc->phys_encs[i];
+
+		phys->hw_intf->ops.enable_avr(phys->hw_intf, true);
+		phys->hw_ctl->ops.update_pending_flush_intf(phys->hw_ctl,
+							  phys->hw_intf->idx);
+	}
+	spin_unlock_irqrestore(&enc->enc_spinlock, flags);
+	return 0;
+}
+
+int dpu_encoder_exit_vrr(struct drm_encoder *encoder)
+{
+	struct dpu_encoder_virt *enc = to_dpu_encoder_virt(encoder);
+	struct msm_drm_private *priv = encoder->dev->dev_private;
+	struct dpu_encoder_phys *master = enc->cur_master;
+	struct dpu_hw_ctl *ctl;
+	unsigned long flags;
+	u32 index = enc->disp_info.h_tile_instance[0];
+	u32 timeout_ms, vsync_count;
+	unsigned int i;
+	int ret;
+
+	if (!dpu_encoder_vrr_active(encoder))
+		return 0;
+
+	/* This runs before bridge disable while runtime PM and commit locks hold. */
+	ret = dpu_encoder_resource_control(encoder, DPU_ENC_RC_EVENT_KICKOFF);
+	if (ret)
+		return ret;
+	ret = drm_crtc_vblank_get(enc->crtc);
+	if (ret)
+		return ret;
+	ctl = master->hw_ctl;
+	timeout_ms = max(50U, dpu_encoder_vrr_timeout_ms(encoder, 2));
+
+	spin_lock_irqsave(&enc->enc_spinlock, flags);
+	for (i = 0; i < enc->num_phys_encs; i++) {
+		struct dpu_encoder_phys *phys = enc->phys_encs[i];
+
+		phys->hw_intf->ops.enable_avr(phys->hw_intf, false);
+		ctl->ops.update_pending_flush_intf(ctl, phys->hw_intf->idx);
+	}
+	/* Configuration-only flush: do not create a synthetic page-flip waiter. */
+	ctl->ops.trigger_flush(ctl);
+	vsync_count = atomic_read(&master->vsync_cnt);
+	for (i = 0; i < enc->num_phys_encs; i++) {
+		struct dpu_hw_intf *intf = enc->phys_encs[i]->hw_intf;
+
+		intf->ops.trigger_avr(intf);
+	}
+	spin_unlock_irqrestore(&enc->enc_spinlock, flags);
+
+	ret = wait_event_timeout(master->pending_kickoff_wq,
+				atomic_read(&master->vsync_cnt) != vsync_count &&
+				!ctl->ops.get_flush_register(ctl),
+				msecs_to_jiffies(timeout_ms));
+	drm_crtc_vblank_put(enc->crtc);
+	if (!ret) {
+		WRITE_ONCE(enc->avr_failed, true);
+		return -ETIMEDOUT;
+	}
+	ret = msm_dsi_set_avr(priv->kms->dsi[index], false);
+	if (!ret)
+		WRITE_ONCE(enc->avr_max_vtotal, 0);
+	return ret;
+}
+
+int dpu_encoder_prepare_vrr(struct drm_encoder *encoder, u32 max_vtotal,
+			    bool modeset)
+{
+	struct dpu_encoder_virt *enc = to_dpu_encoder_virt(encoder);
+
+	if (!dpu_encoder_vrr_active(encoder) ||
+	    (!modeset && max_vtotal == enc->avr_max_vtotal &&
+	     !READ_ONCE(enc->avr_failed)))
+		return 0;
+	return dpu_encoder_exit_vrr(encoder);
+}
+
 bool dpu_encoder_can_update_vfp(struct drm_encoder *encoder,
 			       const struct drm_display_mode *mode)
 {
@@ -1376,6 +1587,7 @@ void dpu_encoder_virt_runtime_resume(struct drm_encoder *drm_enc)
 	if (!dpu_enc->enabled)
 		goto out;
 
+	WRITE_ONCE(dpu_enc->avr_max_vtotal, 0);
 	if (dpu_enc->cur_slave && dpu_enc->cur_slave->ops.restore)
 		dpu_enc->cur_slave->ops.restore(dpu_enc->cur_slave);
 	if (dpu_enc->cur_master && dpu_enc->cur_master->ops.restore)
@@ -1395,6 +1607,7 @@ static void dpu_encoder_virt_atomic_enable(struct drm_encoder *drm_enc,
 	struct drm_display_mode *cur_mode = NULL;
 
 	dpu_enc = to_dpu_encoder_virt(drm_enc);
+	WRITE_ONCE(dpu_enc->avr_max_vtotal, 0);
 	dpu_enc->dsc = dpu_encoder_get_dsc_config(drm_enc);
 
 	atomic_set(&dpu_enc->frame_done_timeout_cnt, 0);
@@ -1428,6 +1641,7 @@ static void dpu_encoder_virt_atomic_enable(struct drm_encoder *drm_enc,
 
 	_dpu_encoder_virt_enable_helper(drm_enc);
 
+	WRITE_ONCE(dpu_enc->avr_failed, false);
 	dpu_enc->enabled = true;
 
 out:
@@ -2166,6 +2380,11 @@ void dpu_encoder_prepare_for_kickoff(struct drm_encoder *drm_enc)
 
 	dpu_encoder_resource_control(drm_enc, DPU_ENC_RC_EVENT_KICKOFF);
 
+	/* Exit AVR before the CTL reset invalidates its flush handshake. */
+	if (needs_hw_reset && dpu_encoder_vrr_active(drm_enc) &&
+	    dpu_encoder_exit_vrr(drm_enc))
+		DPU_ERROR_ENC(dpu_enc, "AVR exit failed before CTL recovery\n");
+
 	/* if any phys needs reset, reset all phys, in-order */
 	if (needs_hw_reset) {
 		trace_dpu_enc_prepare_kickoff_reset(DRMID(drm_enc));
@@ -2176,6 +2395,10 @@ void dpu_encoder_prepare_for_kickoff(struct drm_encoder *drm_enc)
 
 	if (dpu_enc->dsc)
 		dpu_encoder_prep_dsc(dpu_enc, dpu_enc->dsc);
+
+	if (dpu_encoder_configure_vrr(drm_enc,
+			to_dpu_crtc_state(drm_enc->crtc->state)->avr_max_vtotal))
+		DPU_ERROR_ENC(dpu_enc, "failed to configure AVR; keeping fixed timing\n");
 }
 
 /**
@@ -2215,6 +2438,8 @@ void dpu_encoder_start_frame_done_timer(struct drm_encoder *drm_enc)
 	dpu_enc = to_dpu_encoder_virt(drm_enc);
 	timeout_ms = DPU_ENCODER_FRAME_DONE_TIMEOUT_FRAMES * 1000 /
 			drm_mode_vrefresh(&drm_enc->crtc->state->adjusted_mode);
+	timeout_ms = max_t(unsigned long, timeout_ms,
+		dpu_encoder_vrr_timeout_ms(drm_enc, DPU_ENCODER_FRAME_DONE_TIMEOUT_FRAMES));
 
 	atomic_set(&dpu_enc->frame_done_timeout_ms, timeout_ms);
 	mod_timer(&dpu_enc->frame_done_timer,
@@ -2248,6 +2473,19 @@ void dpu_encoder_kickoff(struct drm_encoder *drm_enc)
 			phys->ops.handle_post_kickoff(phys);
 	}
 
+	/* Both interfaces see the new planes before either AVR trigger. */
+	if (dpu_encoder_vrr_active(drm_enc)) {
+		unsigned long flags;
+
+		spin_lock_irqsave(&dpu_enc->enc_spinlock, flags);
+		for (i = 0; i < dpu_enc->num_phys_encs; i++) {
+			struct dpu_hw_intf *intf = dpu_enc->phys_encs[i]->hw_intf;
+
+			intf->ops.trigger_avr(intf);
+		}
+		spin_unlock_irqrestore(&dpu_enc->enc_spinlock, flags);
+	}
+
 	DPU_ATRACE_END("encoder_kickoff");
 }
 
@@ -2804,6 +3042,9 @@ static void dpu_encoder_frame_done_timeout(struct timer_list *t)
 	}
 
 	DPU_ERROR_ENC_RATELIMITED(dpu_enc, "frame done timeout\n");
+	/* Defer MMIO recovery to the next serialized, powered commit. */
+	if (dpu_encoder_vrr_active(drm_enc))
+		WRITE_ONCE(dpu_enc->avr_failed, true);
 
 	if (atomic_inc_return(&dpu_enc->frame_done_timeout_cnt) == 1)
 		msm_disp_snapshot_state(drm_enc->dev);
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.h b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.h
index ef884b0bb..67b605180 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.h
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.h
@@ -12,6 +12,8 @@
 #include <drm/drm_crtc.h>
 #include "dpu_hw_mdss.h"
 
+struct dpu_encoder_phys;
+
 #define DPU_ENCODER_FRAME_EVENT_DONE			BIT(0)
 #define DPU_ENCODER_FRAME_EVENT_ERROR			BIT(1)
 #define DPU_ENCODER_FRAME_EVENT_PANEL_DEAD		BIT(2)
@@ -21,6 +23,16 @@
 
 #define MAX_H_TILES_PER_DISPLAY 2
 
+u32 dpu_encoder_check_vrr(struct drm_encoder *encoder,
+			 struct drm_atomic_commit *state,
+			 struct drm_crtc_state *crtc_state);
+bool dpu_encoder_vrr_active(struct drm_encoder *encoder);
+u32 dpu_encoder_vrr_timeout_ms(struct drm_encoder *encoder, u32 frames);
+int dpu_encoder_exit_vrr(struct drm_encoder *encoder);
+int dpu_encoder_prepare_vrr(struct drm_encoder *encoder, u32 max_vtotal,
+			    bool modeset);
+int dpu_encoder_phys_vid_setup_avr(struct dpu_encoder_phys *phys, u32 max_vtotal);
+
 bool dpu_encoder_can_update_vfp(struct drm_encoder *encoder,
 			       const struct drm_display_mode *mode);
 void dpu_encoder_update_vfp(struct drm_encoder *encoder,
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
index a40baca2f..c06edc1b9 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
@@ -146,6 +146,22 @@ static void drm_mode_to_intf_timing_params(
 	}
 }
 
+int dpu_encoder_phys_vid_setup_avr(struct dpu_encoder_phys *phys, u32 max_vtotal)
+{
+	struct drm_display_mode mode = phys->cached_mode;
