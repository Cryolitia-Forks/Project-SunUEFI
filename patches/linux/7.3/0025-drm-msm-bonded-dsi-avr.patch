+int msm_dsi_hosts_set_avr(struct mipi_dsi_host *master,
+			  struct mipi_dsi_host *slave, bool enable)
+{
+	struct msm_dsi_host *first = to_msm_dsi_host(master);
+	struct msm_dsi_host *second = slave ? to_msm_dsi_host(slave) : NULL;
+	int ret;
+
+	/* The manager always passes the clock master before the clock slave. */
+	mutex_lock(&first->dev_mutex);
+	if (second)
+		mutex_lock_nested(&second->dev_mutex, SINGLE_DEPTH_NESTING);
+
+	/* Check both links before changing either controller's receiver state. */
+	ret = dsi_host_check_avr(first);
+	if (ret)
+		goto unlock;
+	if (second) {
+		ret = dsi_host_check_avr(second);
+		if (ret)
+			goto unlock;
+	}
+
+	dsi_host_write_avr(first, enable);
+	if (second)
+		dsi_host_write_avr(second, enable);
+
+unlock:
+	if (second)
+		mutex_unlock(&second->dev_mutex);
+	mutex_unlock(&first->dev_mutex);
+	return ret;
+}
