From d342bbcf941ee7a120abfe74abfa255c98886e7f Mon Sep 17 00:00:00 2001
From: Cryolitia PukNgae <cryolitia@gmail.com>
Date: Fri, 6 Nov 2026 20:00:00 +0800
Subject: [PATCH] media: i2c: s5kjn1: report the current mode crop height

The active crop is the sensor mode rectangle. Returning its width as
the height makes the rectangular modes appear square to V4L2 users.

Signed-off-by: Cryolitia PukNgae <cryolitia@gmail.com>
---
 drivers/media/i2c/s5kjn1.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/media/i2c/s5kjn1.c b/drivers/media/i2c/s5kjn1.c
index bca4f0b91..e21add566 100644
--- a/drivers/media/i2c/s5kjn1.c
+++ b/drivers/media/i2c/s5kjn1.c
@@ -1100,7 +1100,7 @@ static int s5kjn1_get_selection(struct v4l2_subdev *sd,
 		sel->r.left = 0;
 		sel->r.top = 0;
 		sel->r.width = s5kjn1->mode->width;
-		sel->r.height = s5kjn1->mode->width;
+		sel->r.height = s5kjn1->mode->height;
 		return 0;
 	default:
 		return -EINVAL;
