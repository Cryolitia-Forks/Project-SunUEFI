++/* SPDX-License-Identifier: GPL-3.0-or-later */
++#ifndef _LIBSSC_DISCOVERY_H_
++#define _LIBSSC_DISCOVERY_H_
++
++#include <gio/gio.h>
++
++G_BEGIN_DECLS
++
++/**
++ * ssc_sensor_discover:
++ * @data_type: exact SSC data type, for example "sar_sensor"
++ * @only_default: return the default instance instead of all instances
++ * @cancellable: (nullable): cancellation for discovery and attribute requests
++ * @callback: called when every returned UID has its attributes
++ * @user_data: callback data
++ *
++ * Discover metadata without enabling sensor reports or registry writes.
++ * Unlike ssc_sensor_new(), this preserves every returned UID and attribute.
++ * Cancel the operation if the DSP does not answer; no periodic updates are
++ * requested. An empty UID response succeeds with an empty result array.
++ */
++void ssc_sensor_discover (const gchar *data_type, gboolean only_default,
++                         GCancellable *cancellable,
++                         GAsyncReadyCallback callback, gpointer user_data);
++
++/**
++ * ssc_sensor_discover_finish:
++ * @result: result of ssc_sensor_discover()
++ * @error: return location for an error
++ *
++ * Each aa{sv} entry contains data-type (s), uid-high/uid-low (t),
++ * attributes (a(iaa{sv})) and attributes-raw (ay). Attributes preserve their
++ * original numeric IDs and all values. Value dictionaries use protobuf field
++ * names a (nested aa{sv}), s (string), f (double), i (uint64), b (boolean).
++ * The original protobuf bytes also preserve unknown fields and float bits.
++ * No physical units, calibration status or near/far meaning are inferred.
++ *
++ * Returns: (transfer full) (nullable): discovered metadata, or NULL on error
++ */
++GVariant *ssc_sensor_discover_finish (GAsyncResult *result, GError **error);
++
++G_END_DECLS
++
++#endif
