+--- /dev/null
++++ b/src/libssc-discovery.c
+@@ -0,0 +1,281 @@
++/* SPDX-License-Identifier: GPL-3.0-or-later */
++#include "libssc-discovery.h"
++#include "libssc-client-private.h"
++#include "ssc-sensor-suid.pb-c.h"
++
++typedef struct {
++    guint64 high;
++    guint64 low;
++} SensorUid;
++
++typedef struct {
++    gchar *data_type;
++    gboolean only_default;
++    gboolean received_uids;
++    gboolean finished;
++    SSCClient *client;
++    gulong report_id;
++    GSource *cancel_source;
++    GArray *uids;
++    guint index;
++    GVariantBuilder sensors;
++} Discovery;
++
++static void request_attributes (GTask *task);
++
++static void
++discovery_free (gpointer data)
++{
++    Discovery *discovery = data;
++
++    g_clear_object (&discovery->client);
++    g_clear_pointer (&discovery->uids, g_array_unref);
++    g_variant_builder_clear (&discovery->sensors);
++    g_free (discovery->data_type);
++    g_free (discovery);
++}
++
++static void
++discovery_complete (GTask *task, GError *error)
++{
++    Discovery *discovery = g_task_get_task_data (task);
++
++    if (discovery->finished) {
++        g_clear_error (&error);
++        return;
++    }
++    discovery->finished = TRUE;
++    if (discovery->report_id) {
++        g_signal_handler_disconnect (discovery->client, discovery->report_id);
++        discovery->report_id = 0;
++    }
++    if (discovery->cancel_source) {
++        g_source_destroy (discovery->cancel_source);
++        g_clear_pointer (&discovery->cancel_source, g_source_unref);
++    }
++
++    if (error)
++        g_task_return_error (task, error);
++    else
++        g_task_return_pointer (task,
++            g_variant_ref_sink (g_variant_builder_end (&discovery->sensors)),
++            (GDestroyNotify) g_variant_unref);
++    g_object_unref (task);
++}
++
++static gboolean
++discovery_cancelled (GCancellable *cancellable, gpointer data)
++{
++    discovery_complete (G_TASK (data),
++        g_error_new_literal (G_IO_ERROR, G_IO_ERROR_CANCELLED,
++                             "SSC metadata discovery cancelled"));
++    return G_SOURCE_REMOVE;
++}
++
++static GVariant *
++attribute_value (const SscAttrValue *value)
++{
++    GVariantBuilder fields;
++
++    g_variant_builder_init (&fields, G_VARIANT_TYPE_VARDICT);
++    if (value->a) {
++        GVariantBuilder elements;
++
++        g_variant_builder_init (&elements, G_VARIANT_TYPE ("aa{sv}"));
++        for (gsize i = 0; i < value->a->n_element; i++)
++            g_variant_builder_add_value (&elements, attribute_value (value->a->element[i]));
++        g_variant_builder_add (&fields, "{sv}", "a", g_variant_builder_end (&elements));
++    }
++    if (value->s)
++        g_variant_builder_add (&fields, "{sv}", "s", g_variant_new_string (value->s));
++    if (value->has_f)
++        g_variant_builder_add (&fields, "{sv}", "f", g_variant_new_double (value->f));
++    if (value->has_i)
++        g_variant_builder_add (&fields, "{sv}", "i", g_variant_new_uint64 (value->i));
++    if (value->has_b)
++        g_variant_builder_add (&fields, "{sv}", "b", g_variant_new_boolean (value->b));
++    return g_variant_builder_end (&fields);
++}
++
++static GVariant *
++sensor_metadata (Discovery *discovery, const SscAttrResponse *response, GArray *raw)
++{
++    GVariantBuilder sensor, attributes;
++    SensorUid uid = g_array_index (discovery->uids, SensorUid, discovery->index);
++
++    g_variant_builder_init (&attributes, G_VARIANT_TYPE ("a(iaa{sv})"));
++    for (gsize i = 0; i < response->n_attr; i++) {
++        const SscAttr *attribute = response->attr[i];
++        GVariantBuilder values;
++
++        g_variant_builder_init (&values, G_VARIANT_TYPE ("aa{sv}"));
++        for (gsize j = 0; j < attribute->value_array->n_v; j++)
++            g_variant_builder_add_value (&values, attribute_value (attribute->value_array->v[j]));
++        g_variant_builder_add (&attributes, "(i@aa{sv})", attribute->id,
++                               g_variant_builder_end (&values));
++    }
++
++    g_variant_builder_init (&sensor, G_VARIANT_TYPE_VARDICT);
++    g_variant_builder_add (&sensor, "{sv}", "data-type", g_variant_new_string (discovery->data_type));
++    g_variant_builder_add (&sensor, "{sv}", "uid-high", g_variant_new_uint64 (uid.high));
++    g_variant_builder_add (&sensor, "{sv}", "uid-low", g_variant_new_uint64 (uid.low));
++    g_variant_builder_add (&sensor, "{sv}", "attributes", g_variant_builder_end (&attributes));
++    g_variant_builder_add (&sensor, "{sv}", "attributes-raw",
++        g_variant_new_fixed_array (G_VARIANT_TYPE_BYTE, raw->data, raw->len, 1));
++    return g_variant_builder_end (&sensor);
++}
++
++static void
++request_sent (GObject *object, GAsyncResult *result, gpointer data)
++{
++    GTask *task = G_TASK (data);
++    Discovery *discovery = g_task_get_task_data (task);
++    g_autoptr (GError) error = NULL;
++
++    if (!ssc_client_send_finish (SSC_CLIENT (object), result, &error) && !discovery->finished)
++        discovery_complete (task, g_steal_pointer (&error));
++    g_object_unref (task);
++}
++
++static void
++metadata_received (SSCClient *client, guint32 message_id, guint64 high,
++                   guint64 low, GArray *raw, gpointer data)
++{
++    GTask *task = G_TASK (data);
++    Discovery *discovery = g_task_get_task_data (task);
++
++    if (discovery->finished)
++        return;
++
++    if (!discovery->received_uids && high == SSC_SENSOR_UID_SUID_HIGH &&
++        low == SSC_SENSOR_UID_SUID_LOW && message_id == SSC_MSG_RESPONSE_SUID) {
++        SscSuidResponse *response = ssc_suid_response__unpack (NULL, raw->len,
++                                                            (guint8 *) raw->data);
++
++        if (!response) {
++            discovery_complete (task, g_error_new_literal (G_IO_ERROR,
++                G_IO_ERROR_INVALID_DATA, "Malformed SSC SUID response"));
++            return;
++        }
++        if (g_strcmp0 (response->data_type, discovery->data_type) != 0) {
++            ssc_suid_response__free_unpacked (response, NULL);
++            return;
++        }
++
++        discovery->received_uids = TRUE;
++        for (gsize i = 0; i < response->n_uid; i++) {
++            SensorUid uid = {response->uid[i]->high, response->uid[i]->low};
++
++            g_array_append_val (discovery->uids, uid);
++        }
++        ssc_suid_response__free_unpacked (response, NULL);
++        request_attributes (task);
++    } else if (discovery->received_uids && discovery->index < discovery->uids->len) {
++        SensorUid uid = g_array_index (discovery->uids, SensorUid, discovery->index);
++        SscAttrResponse *response;
++
++        if (high != uid.high || low != uid.low || message_id != SSC_MSG_RESPONSE_GET_ATTRIBUTES)
++            return;
++        response = ssc_attr_response__unpack (NULL, raw->len, (guint8 *) raw->data);
++        if (!response) {
++            discovery_complete (task, g_error_new_literal (G_IO_ERROR,
++                G_IO_ERROR_INVALID_DATA, "Malformed SSC attribute response"));
++            return;
++        }
++        g_variant_builder_add_value (&discovery->sensors, sensor_metadata (discovery, response, raw));
++        ssc_attr_response__free_unpacked (response, NULL);
++        discovery->index++;
++        request_attributes (task);
++    }
++}
++
++static void
++request_attributes (GTask *task)
++{
++    Discovery *discovery = g_task_get_task_data (task);
++    g_autoptr (GArray) payload = g_array_new (FALSE, FALSE, 1);
++    SscAttrRequest request = SSC_ATTR_REQUEST__INIT;
++    SensorUid uid;
++
++    if (discovery->index == discovery->uids->len) {
++        discovery_complete (task, NULL);
++        return;
++    }
++    uid = g_array_index (discovery->uids, SensorUid, discovery->index);
++    request.has_enable_updates = TRUE;
++    request.enable_updates = FALSE;
++    g_array_set_size (payload, ssc_attr_request__get_packed_size (&request));
++    ssc_attr_request__pack (&request, (guint8 *) payload->data);
++    ssc_client_send (discovery->client, uid.high, uid.low, SSC_MSG_REQUEST_GET_ATTRIBUTES,
++                    payload, g_task_get_cancellable (task), request_sent, g_object_ref (task));
++}
++
++static void
++discovery_client_ready (GObject *object, GAsyncResult *result, gpointer data)
++{
++    GTask *task = G_TASK (data);
++    Discovery *discovery = g_task_get_task_data (task);
++    g_autoptr (GError) error = NULL;
++    g_autoptr (SSCClient) client = ssc_client_new_finish (result, &error);
++
++    if (!discovery->finished) {
++        if (!client) {
++            discovery_complete (task, g_steal_pointer (&error));
++        } else {
++            g_autoptr (GArray) payload = g_array_new (FALSE, FALSE, 1);
++            SscSuidRequest request = SSC_SUID_REQUEST__INIT;
++
++            discovery->client = g_steal_pointer (&client);
++            discovery->report_id = g_signal_connect (discovery->client, "report",
++                G_CALLBACK (metadata_received), task);
++            request.data_type = discovery->data_type;
++            request.has_enable_updates = TRUE;
++            request.enable_updates = FALSE;
++            request.has_only_default_values = TRUE;
++            request.only_default_values = discovery->only_default;
++            g_array_set_size (payload, ssc_suid_request__get_packed_size (&request));
++            ssc_suid_request__pack (&request, (guint8 *) payload->data);
++            ssc_client_send (discovery->client, SSC_SENSOR_UID_SUID_HIGH,
++                SSC_SENSOR_UID_SUID_LOW, SSC_MSG_REQUEST_SUID, payload,
++                g_task_get_cancellable (task), request_sent, g_object_ref (task));
++        }
++    }
++    g_object_unref (task);
++}
++
++void
++ssc_sensor_discover (const gchar *data_type, gboolean only_default,
++                     GCancellable *cancellable, GAsyncReadyCallback callback,
++                     gpointer user_data)
++{
++    GTask *task;
++    Discovery *discovery;
++
++    g_return_if_fail (data_type && *data_type);
++
++    task = g_task_new (NULL, cancellable, callback, user_data);
++    g_task_set_source_tag (task, ssc_sensor_discover);
++    discovery = g_new0 (Discovery, 1);
++    discovery->data_type = g_strdup (data_type);
++    discovery->only_default = only_default;
++    discovery->uids = g_array_new (FALSE, FALSE, sizeof (SensorUid));
++    g_variant_builder_init (&discovery->sensors, G_VARIANT_TYPE ("aa{sv}"));
++    g_task_set_task_data (task, discovery, discovery_free);
++
++    /* Dispatch cancellation on the task's context, alongside QMI reports. */
++    if (cancellable) {
++        discovery->cancel_source = g_cancellable_source_new (cancellable);
++        g_source_set_callback (discovery->cancel_source, (GSourceFunc) discovery_cancelled,
++                               task, NULL);
++        g_source_attach (discovery->cancel_source, g_task_get_context (task));
++    }
++    ssc_client_new (cancellable, discovery_client_ready, g_object_ref (task));
++}
++
++GVariant *
++ssc_sensor_discover_finish (GAsyncResult *result, GError **error)
++{
++    g_return_val_if_fail (g_task_is_valid (result, NULL), NULL);
++    g_return_val_if_fail (g_async_result_is_tagged (result, ssc_sensor_discover), NULL);
++    return g_task_propagate_pointer (G_TASK (result), error);
++}
