++        g_cancellable_cancel (cancellable);
++    ssc_sensor_discover ("sar_sensor", test_case != CASE_ALL, cancellable, discovered, &capture);
++    if (test_case == CASE_CANCEL)
++        g_timeout_add (1, cancel_discovery, cancellable);
++    g_main_loop_run (capture.loop);
++
++    if (test_case == CASE_CANCEL || test_case == CASE_CANCEL_EARLY) {
++        g_assert_error (capture.error, G_IO_ERROR, G_IO_ERROR_CANCELLED);
