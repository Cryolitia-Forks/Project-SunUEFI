+static int loopback_rate(struct cam *c, unsigned int fps)
+{
+	struct v4l2_streamparm p = {
+		.type = V4L2_BUF_TYPE_VIDEO_OUTPUT,
+		.parm.output.timeperframe = { .numerator = 1, .denominator = fps },
